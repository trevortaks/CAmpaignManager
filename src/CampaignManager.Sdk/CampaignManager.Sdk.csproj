<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CampaignManager.Sdk</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Description>Typed C# client SDK for the CampaignManager API: create and track campaigns, manage recurring series, templates and compliance suppressions without hand-rolling HTTP calls.</Description>
    <!-- TODO: confirm Authors / Company / RepositoryUrl / PackageProjectUrl / license with the team before
         a public release; no git remote or LICENSE file exists, so Source Link cannot be configured honestly. -->
    <Authors>CampaignManager</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc on every public member (ctors, trivial properties) is excessive
         ceremony here — the meaningful types/methods already carry summaries. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageTags>campaigns;messaging;sms;email;whatsapp;multi-tenant</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
