@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var sectionNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Dashboard"] = "Dashboard",
        ["Campaigns"] = "Campaigns",
        ["CampaignSeries"] = "Recurring Campaigns",
        ["Providers"] = "Providers",
        ["Templates"] = "Templates",
        ["Reports"] = "Reports",
        ["ApiKeys"] = "API Keys",
        ["Users"] = "Users",
        ["Audit"] = "Audit Log",
        ["Notifications"] = "Notifications",
        ["Account"] = "Account",
        ["Home"] = "Campaign Manager",
    };
    var sectionName = sectionNames.TryGetValue(currentController, out var name) ? name : currentController;
}
<header class="topbar">
  <button type="button" class="topbar-toggle d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#sidebar"
          aria-controls="sidebar" aria-label="Toggle navigation">
    <svg class="icon icon-lg" aria-hidden="true"><use href="@Url.Content("~/icons/sprite.svg")#icon-hamburger"></use></svg>
  </button>
  <h2 class="topbar-section">@sectionName</h2>
  <div class="topbar-spacer"></div>
</header>
