@model CampaignManager.Application.Notifications.NotificationSettingsDto
@{
    ViewData["Title"] = "Notifications";
    var log = (IReadOnlyList<CampaignManager.Domain.Entities.NotificationLog>)ViewBag.Log;
}
<h1 class="h3 mb-3">Notifications</h1>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-body">
        <h2 class="h6 text-muted">Settings</h2>
        <form method="post" asp-action="Save">
          @Html.AntiForgeryToken()
          <div class="mb-3">
            <label class="form-label">Recipient email</label>
            <input class="form-control" type="email" name="recipientEmail" value="@Model.RecipientEmail" />
            <div class="form-text">Requires SMTP relay configuration under <code>Notifications:Smtp</code>; without it, events are still logged below.</div>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" name="notifyProviderOffline" value="true"
                   checked="@Model.NotifyProviderOffline" id="notifyProviderOffline" />
            <label class="form-check-label" for="notifyProviderOffline">Provider offline / auth failed</label>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" name="notifyCampaignCompleted" value="true"
                   checked="@Model.NotifyCampaignCompleted" id="notifyCampaignCompleted" />
            <label class="form-check-label" for="notifyCampaignCompleted">Campaign completed</label>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="notifyCampaignFailed" value="true"
                   checked="@Model.NotifyCampaignFailed" id="notifyCampaignFailed" />
            <label class="form-check-label" for="notifyCampaignFailed">Campaign failed / high failure rate</label>
          </div>
          <div class="mb-3">
            <label class="form-label">High failure rate threshold (%)</label>
            <input class="form-control" type="number" name="highFailureRateThreshold" min="1" max="100"
                   value="@((Model.HighFailureRateThreshold * 100).ToString("0"))" />
          </div>
          <button class="btn btn-primary" type="submit">Save</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card">
      <div class="card-body">
        <h2 class="h6 text-muted">Recent notifications</h2>
        <table class="table table-sm mb-0">
          <thead><tr><th>When (UTC)</th><th>Event</th><th>Subject</th><th>Status</th></tr></thead>
          <tbody>
            @foreach (var entry in log)
            {
              <tr>
                <td class="text-nowrap">@entry.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@entry.EventType</td>
                <td>@entry.Subject</td>
                <td>
                  @if (entry.Sent)
                  { <span class="badge text-bg-success">Sent</span> }
                  else
                  { <span class="badge text-bg-secondary" title="@entry.Error">Logged only</span> }
                </td>
              </tr>
            }
            @if (log.Count == 0)
            {
              <tr><td colspan="4" class="text-muted">No notifications yet.</td></tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
