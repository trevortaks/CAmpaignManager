@model CampaignManager.Application.Admin.Dashboard.DashboardData
@{
    ViewData["Title"] = "Dashboard";
}
<h1 class="h3 mb-3">Dashboard</h1>

<div class="row g-3 mb-3">
  @foreach (var (label, value, colorClass, icon) in new (string, string, string, string)[]
  {
      ("Campaigns today", Model.CampaignsToday.ToString("N0"), "text-bg-primary", "icon-campaigns"),
      ("Sent today", Model.SentToday.ToString("N0"), "text-bg-success", "icon-check-circle"),
      ("Failed today", Model.FailedToday.ToString("N0"), "text-bg-danger", "icon-alert"),
      ("Pending messages", Model.PendingMessages.ToString("N0"), "text-bg-warning", "icon-clock"),
      ("Active providers", Model.ActiveProviders.ToString("N0"), "text-bg-info", "icon-server")
  })
  {
    <div class="col">
      <div class="card h-100">
        <div class="card-body info-box">
          <div class="info-box-icon @colorClass">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/icons/sprite.svg")#@icon"></use></svg>
          </div>
          <div>
            <div class="info-box-label">@label</div>
            <div class="info-box-value">@value</div>
          </div>
        </div>
      </div>
    </div>
  }
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <h2 class="card-title">Messages sent — last 14 days</h2>
        <div class="card-tools">
          <button type="button" class="btn-tool" data-bs-toggle="collapse" data-bs-target="#chart-sentTrend" aria-label="Toggle chart">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/icons/sprite.svg")#icon-minimize"></use></svg>
          </button>
        </div>
      </div>
      <div class="collapse show" id="chart-sentTrend">
        <div class="card-body">
          <div class="chart-container" style="height:180px">
            <canvas id="sentTrend" role="img" aria-label="Line chart of messages sent per day"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <h2 class="card-title">Messages failed — last 14 days</h2>
        <div class="card-tools">
          <button type="button" class="btn-tool" data-bs-toggle="collapse" data-bs-target="#chart-failedTrend" aria-label="Toggle chart">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/icons/sprite.svg")#icon-minimize"></use></svg>
          </button>
        </div>
      </div>
      <div class="collapse show" id="chart-failedTrend">
        <div class="card-body">
          <div class="chart-container" style="height:180px">
            <canvas id="failedTrend" role="img" aria-label="Line chart of messages failed per day"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header">
        <h2 class="card-title">By channel — last 30 days</h2>
        <div class="card-tools">
          <button type="button" class="btn-tool" data-bs-toggle="collapse" data-bs-target="#chart-byChannel" aria-label="Toggle chart">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/icons/sprite.svg")#icon-minimize"></use></svg>
          </button>
        </div>
      </div>
      <div class="collapse show" id="chart-byChannel">
        <div class="card-body">
          <div class="chart-container" style="height:200px">
            <canvas id="byChannel" role="img" aria-label="Bar chart of sent and failed by channel"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header">
        <h2 class="card-title">By provider — last 30 days</h2>
        <div class="card-tools">
          <button type="button" class="btn-tool" data-bs-toggle="collapse" data-bs-target="#chart-byProvider" aria-label="Toggle chart">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/icons/sprite.svg")#icon-minimize"></use></svg>
          </button>
        </div>
      </div>
      <div class="collapse show" id="chart-byProvider">
        <div class="card-body">
          <div class="chart-container" style="height:200px">
            <canvas id="byProvider" role="img" aria-label="Bar chart of messages sent per provider"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-3">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 text-muted">Provider health</h2>
      <ul class="list-unstyled mb-0">
        @foreach (var provider in Model.ProviderHealthList)
        {
          <li class="mb-1">
            @if (!provider.IsEnabled)
            { <span title="disabled">⏸</span> }
            else if (provider.LastTestSucceeded == false)
            { <span class="text-danger" title="last test failed">✘</span> }
            else
            { <span class="text-success" title="ok">✔</span> }
            @provider.Name <span class="text-muted small">(@provider.Channel)</span>
          </li>
        }
      </ul>
    </div></div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 text-muted">Recent campaigns</h2>
      <table class="table table-sm mb-0">
        <tbody>
        @foreach (var campaign in Model.RecentCampaigns)
        {
          <tr>
            <td><a asp-controller="Campaigns" asp-action="Details" asp-route-id="@campaign.Id">@campaign.Name</a></td>
            <td>@campaign.Channel</td><td>@campaign.Status</td>
            <td class="text-end">@campaign.Total.ToString("N0")</td>
            <td class="text-muted">@campaign.WhenUtc?.ToString("MM-dd HH:mm")</td>
          </tr>
        }
        </tbody>
      </table>
    </div></div>
  </div>
  <div class="col-lg-6">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 text-muted">Scheduled campaigns</h2>
      <table class="table table-sm mb-0">
        <tbody>
        @foreach (var campaign in Model.ScheduledCampaigns)
        {
          <tr>
            <td><a asp-controller="Campaigns" asp-action="Details" asp-route-id="@campaign.Id">@campaign.Name</a></td>
            <td>@campaign.Channel</td>
            <td class="text-end">@campaign.Total.ToString("N0")</td>
            <td class="text-muted">@campaign.WhenUtc?.ToString("yyyy-MM-dd HH:mm") UTC</td>
          </tr>
        }
        @if (Model.ScheduledCampaigns.Count == 0)
        {
          <tr><td class="text-muted">None scheduled.</td></tr>
        }
        </tbody>
      </table>
    </div></div>
  </div>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    (function () {
      // Reads the active theme's colors from CSS custom properties at render time, so the
      // same code draws correctly in both light and dark mode without duplicating palettes.
      function chartColors() {
        var cs = getComputedStyle(document.documentElement);
        var v = function (name) { return cs.getPropertyValue(name).trim(); };
        return {
          surface: v('--chart-surface'),
          grid: v('--chart-grid'),
          ink: v('--chart-ink-primary'),
          inkSecondary: v('--chart-ink-secondary'),
          blue: v('--chart-series-1'),
          critical: v('--status-critical')
        };
      }

      var sentTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
          Model.SentTrend.Select(p => new { date = p.Date.ToString("MM-dd"), count = p.Count })));
      var failedTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
          Model.FailedTrend.Select(p => new { date = p.Date.ToString("MM-dd"), count = p.Count })));
      var byChannel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
          Model.ByChannel.Select(c => new { channel = c.Channel, sent = c.Sent, failed = c.Failed })));
      var byProvider = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
          Model.ByProvider.Select(p => new { provider = p.Provider, sent = p.Sent })));

      // Kept in module scope (not discarded) specifically so themechange can destroy() them
      // before rebuilding — Chart.js instances are not garbage-collected on their own while a
      // reference to them (or their attached canvas) is retained, and re-creating a Chart on
      // a canvas that already has one attached without destroying the old one first is the
      // classic Chart.js memory-leak pattern.
      var charts = [];

      function destroyCharts() {
        charts.forEach(function (c) { c.destroy(); });
        charts = [];
      }

      function lineChart(id, points, color, colors) {
        return new Chart(document.getElementById(id), {
          type: 'line',
          data: {
            labels: points.map(function (p) { return p.date; }),
            datasets: [{
              data: points.map(function (p) { return p.count; }),
              borderColor: color, borderWidth: 2,
              pointRadius: 0, pointHitRadius: 12, tension: 0.2, fill: false
            }]
          },
          options: {
            plugins: { legend: { display: false } },
            scales: {
              x: { grid: { display: false }, ticks: { color: colors.inkSecondary } },
              y: { beginAtZero: true, grid: { color: colors.grid }, ticks: { color: colors.inkSecondary } }
            },
            maintainAspectRatio: false
          }
        });
      }

      function renderCharts() {
        var colors = chartColors();

        charts.push(lineChart('sentTrend', sentTrend, colors.blue, colors));
        charts.push(lineChart('failedTrend', failedTrend, colors.critical, colors));

        charts.push(new Chart(document.getElementById('byChannel'), {
          type: 'bar',
          data: {
            labels: byChannel.map(function (c) { return c.channel; }),
            datasets: [
              { label: 'Sent', data: byChannel.map(function (c) { return c.sent; }), backgroundColor: colors.blue,
                borderColor: colors.surface, borderWidth: 2, borderRadius: 4 },
              { label: 'Failed', data: byChannel.map(function (c) { return c.failed; }), backgroundColor: colors.critical,
                borderColor: colors.surface, borderWidth: 2, borderRadius: 4 }
            ]
          },
          options: {
            plugins: { legend: { position: 'bottom', labels: { color: colors.ink } } },
            scales: {
              x: { grid: { display: false }, ticks: { color: colors.inkSecondary } },
              y: { beginAtZero: true, grid: { color: colors.grid }, ticks: { color: colors.inkSecondary } }
            },
            maintainAspectRatio: false
          }
        }));

        charts.push(new Chart(document.getElementById('byProvider'), {
          type: 'bar',
          data: {
            labels: byProvider.map(function (p) { return p.provider; }),
            datasets: [{
              data: byProvider.map(function (p) { return p.sent; }), backgroundColor: colors.blue,
              borderColor: colors.surface, borderWidth: 2, borderRadius: 4
            }]
          },
          options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: {
              x: { beginAtZero: true, grid: { color: colors.grid }, ticks: { color: colors.inkSecondary } },
              y: { grid: { display: false }, ticks: { color: colors.inkSecondary } }
            },
            maintainAspectRatio: false
          }
        }));
      }

      renderCharts();

      // One listener, registered once — not inside renderCharts() — so toggling the theme
      // repeatedly never accumulates duplicate listeners or duplicate Chart instances.
      window.addEventListener('themechange', function () {
        destroyCharts();
        renderCharts();
      });
    })();
  </script>
}
