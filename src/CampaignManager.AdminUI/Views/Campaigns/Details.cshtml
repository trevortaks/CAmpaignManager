@model CampaignManager.Contracts.Campaigns.CampaignStatusResponse
@{
    ViewData["Title"] = Model.Name;
    var stats = Model.Statistics;
    // Counts only — colors are resolved client-side from CSS custom properties (tokens.css)
    // so the light/dark segment palette lives in one place and the chart updates on toggle.
    var segments = new (string Label, int Count)[]
    {
        ("Queued", stats.Queued),
        ("Processing", stats.Processing),
        ("Sent", stats.Sent),
        ("Delivered", stats.Delivered),
        ("Read", stats.Read),
        ("Expired", stats.Expired),
        ("Rejected", stats.Rejected),
        ("Failed", stats.Failed)
    };
    var visible = segments.Where(s => s.Count > 0).ToArray();
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="Index">Campaigns</a></li>
    <li class="breadcrumb-item active">@Model.Name</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">@Model.Name</h1>
  <span class="badge text-bg-secondary fs-6">@Model.Status</span>
</div>

<div class="row g-3">
  <div class="col-md-5">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted">Message status</h2>
        <div class="chart-container" style="height:220px">
          <canvas id="statusChart" role="img" aria-label="Donut chart of message delivery statuses"></canvas>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-7">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted">Details</h2>
        <dl class="row mb-0">
          <dt class="col-sm-4">Tracking id</dt><dd class="col-sm-8"><code>@Model.TrackingId</code></dd>
          <dt class="col-sm-4">Channel</dt><dd class="col-sm-8">@Model.Channel</dd>
          <dt class="col-sm-4">Scheduled (UTC)</dt><dd class="col-sm-8">@(Model.ScheduledAtUtc?.ToString("u") ?? "—")</dd>
          <dt class="col-sm-4">Started (UTC)</dt><dd class="col-sm-8">@(Model.StartedAtUtc?.ToString("u") ?? "—")</dd>
          <dt class="col-sm-4">Completed (UTC)</dt><dd class="col-sm-8">@(Model.CompletedAtUtc?.ToString("u") ?? "—")</dd>
        </dl>
        <h2 class="h6 text-muted mt-3">Counts</h2>
        <table class="table table-sm mb-0" id="statusCountsTable">
          <tbody>
            <tr><th>Total</th><td class="text-end">@stats.Total.ToString("N0")</td></tr>
            @foreach (var segment in segments)
            {
              <tr>
                <th><span class="status-dot" data-segment="@segment.Label"></span>@segment.Label</th>
                <td class="text-end">@segment.Count.ToString("N0")</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@if (Model.FailureReasons.Count > 0)
{
  <div class="card mt-3">
    <div class="card-body">
      <h2 class="h6 text-muted">Top failure reasons</h2>
      <table class="table table-sm mb-0">
        <tbody>
          @foreach (var reason in Model.FailureReasons)
          {
            <tr><td><code>@reason.Error</code></td><td class="text-end">@reason.Count</td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    (function () {
      var segments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
          visible.Select(s => new { label = s.Label, count = s.Count })));

      // Light/dark pairs from the validated reference palette. Identity is carried by the
      // legend and the counts table (color swatches below), never by hue alone.
      var segmentColors = {
        Queued: { light: '#9a9992', dark: '#b7b6ae' },
        Processing: { light: '#2a78d6', dark: '#3987e5' },
        Sent: { light: '#4a3aa7', dark: '#9085e9' },
        Delivered: { light: '#0ca30c', dark: '#0ca30c' },
        Read: { light: '#008300', dark: '#0ca30c' },
        Expired: { light: '#fab219', dark: '#fab219' },
        Rejected: { light: '#ec835a', dark: '#ec835a' },
        Failed: { light: '#d03b3b', dark: '#e66767' }
      };

      function isDark() {
        return document.documentElement.getAttribute('data-theme') === 'dark';
      }

      function colorFor(label) {
        var pair = segmentColors[label];
        return isDark() ? pair.dark : pair.light;
      }

      function chartColors() {
        var cs = getComputedStyle(document.documentElement);
        var v = function (name) { return cs.getPropertyValue(name).trim(); };
        return { surface: v('--chart-surface'), ink: v('--chart-ink-primary') };
      }

      function paintCountSwatches() {
        document.querySelectorAll('#statusCountsTable .status-dot').forEach(function (dot) {
          dot.style.background = colorFor(dot.dataset.segment);
        });
      }

      // Kept so themechange can destroy() before rebuilding — see Dashboard/Index.cshtml for
      // the full rationale (Chart.js instances are not reclaimed unless destroy()ed first).
      var statusChart = null;

      function renderChart() {
        if (statusChart) statusChart.destroy();
        var colors = chartColors();
        statusChart = new Chart(document.getElementById('statusChart'), {
          type: 'doughnut',
          data: {
            labels: segments.map(function (s) { return s.label; }),
            datasets: [{
              data: segments.map(function (s) { return s.count; }),
              backgroundColor: segments.map(function (s) { return colorFor(s.label); }),
              borderColor: colors.surface,
              borderWidth: 2
            }]
          },
          options: {
            plugins: {
              legend: { position: 'right', labels: { color: colors.ink } }
            },
            maintainAspectRatio: false
          }
        });
      }

      renderChart();
      paintCountSwatches();

      window.addEventListener('themechange', function () {
        renderChart();
        paintCountSwatches();
      });
    })();
  </script>
}
